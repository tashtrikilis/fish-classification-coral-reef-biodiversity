#!/bin/bash -l
#PBS -N yolo_detect_m
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Medium (yolo26m) version of the detection run, for comparison against the
# nano baseline (aqua_run1, mAP50 0.315) and the small run (aqua_run1_small).
# Same data, same epochs/imgsz, only the model size changes — logs to the
# same W&B project (runs_detect) under a different run name so all three
# show up side by side.

cd $PBS_O_WORKDIR

# --- environment setup (confirmed on Aqua: no bare Python module, use Miniconda3) ---
module load Miniconda3
source ~/yolo-venv/bin/activate  # created once via:
                                  #   module load Miniconda3
                                  #   python3 -m venv ~/yolo-venv
                                  #   source ~/yolo-venv/bin/activate
                                  #   pip install -U ultralytics wandb

# --- run training ---
python train_yolo.py \
    --task detect \
    --data data_detect.yaml \
    --model yolo26m.pt \
    --epochs 150 \
    --imgsz 1280 \
    --batch -1 \
    --workers 8 \
    --project runs_detect \
    --name aqua_run1_medium
