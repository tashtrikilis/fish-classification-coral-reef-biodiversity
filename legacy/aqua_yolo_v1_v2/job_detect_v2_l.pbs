#!/bin/bash -l
#PBS -N yolo_detect_v2_l
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Large (yolo26l), v2 restratified split + cls_pw=0.5 -- same data/settings
# as job_detect_v2.pbs (nano)/_s/_m, just the model size changes. Logs to the
# same runs_detect_v2 W&B project under a different run name so
# nano/small/medium/large all show up side by side.
#
# Note: in the nano/small/medium comparison, precision didn't improve at all
# with model size (all three overlapped in the same noisy band) -- only
# recall/mAP did, and medium was still climbing when its run ended. Large is
# worth trying to see if that trend continues, but given how little data
# this is (612 train images, long-tailed across 58 classes), don't be
# surprised if it doesn't clearly beat medium, or starts overfitting instead
# -- worth comparing per_class_metrics.csv against medium's once both are in,
# not just the aggregate W&B curves.

cd $PBS_O_WORKDIR

module load Miniconda3
source ~/yolo-venv/bin/activate

python train_yolo.py \
    --task detect \
    --data data_detect_v2.yaml \
    --model yolo26l.pt \
    --epochs 150 \
    --imgsz 1280 \
    --batch -1 \
    --workers 8 \
    --cls-pw 0.5 \
    --project runs_detect_v2 \
    --name aqua_run1_large
