#!/bin/bash -l
#PBS -N cp_train
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -j oe

# One training run. The submit scripts pass TASK (detect|segment), ARM (baseline|copypaste),
# SEED and the CV options below with qsub -v. To run one by hand:
#   qsub -v TASK=detect,ARM=baseline,SEED=1,DATA_DIR=data_cv/fold0,NAME=detect_baseline_f0_s1,PROJECT=runs_cv,SAVE_PREDS=1 job_train.pbs
# Optional: IMGSZ (default 1280), PROJECT (output folder, default runs).
# If a job hits walltime, resubmit with the same values plus RESUME=1:
#   qsub -v TASK=detect,ARM=baseline,SEED=1,RESUME=1 job_train.pbs
cd $PBS_O_WORKDIR
_WB_OVERRIDE="${WANDB_PROJECT:-}"   # a W&B project passed with qsub -v wins over config.sh
source ./config.sh
if [ -n "$_WB_OVERRIDE" ]; then WANDB_PROJECT="$_WB_OVERRIDE"; fi
module load Miniconda3
source "$VENV/bin/activate"

: "${TASK:?pass TASK=detect|segment}"
: "${ARM:?pass ARM=baseline|copypaste}"
EXTRA=""
if [ "${RESUME:-0}" = "1" ]; then EXTRA="--resume"; fi
# CV options: DATA_DIR, NAME, SAVE_PREDS=1, TAGS (colon-separated), GROUP, MODEL
if [ -n "${DATA_DIR:-}" ];  then EXTRA="$EXTRA --data-dir $DATA_DIR"; fi
if [ -n "${NAME:-}" ];      then EXTRA="$EXTRA --name $NAME"; fi
if [ "${SAVE_PREDS:-0}" = "1" ]; then EXTRA="$EXTRA --save-preds"; fi
if [ -n "${TAGS:-}" ];      then EXTRA="$EXTRA --tags $TAGS"; fi
if [ -n "${GROUP:-}" ];     then EXTRA="$EXTRA --wandb-group $GROUP"; fi
if [ -n "${MODEL:-}" ];     then EXTRA="$EXTRA --model $MODEL"; fi   # e.g. yolo26s.pt, yolo26l-seg.pt

python train_experiment.py \
    --task "$TASK" --arm "$ARM" \
    --epochs 150 --imgsz "${IMGSZ:-1280}" --batch -1 --workers 8 --seed "${SEED:-0}" \
    --project "${PROJECT:-runs}" \
    --wandb-project "$WANDB_PROJECT" $EXTRA
