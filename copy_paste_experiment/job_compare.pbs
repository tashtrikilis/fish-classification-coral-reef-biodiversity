#!/bin/bash -l
#PBS -N cp_compare
#PBS -l select=1:ncpus=1:mem=4GB
#PBS -l walltime=00:30:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Runs after the training jobs: per-arm table + chart, pooled over seeds.
# Optional: RUNS_DIR (default runs) and REF_RUNS_DIR (adds that folder's baseline as a reference column).
cd $PBS_O_WORKDIR
source ./config.sh
module load Miniconda3
source "$VENV/bin/activate"

python compare_results.py --wandb-project "$WANDB_PROJECT" --runs-dir "${RUNS_DIR:-runs}" \
    ${REF_RUNS_DIR:+--ref-runs-dir "$REF_RUNS_DIR"}
