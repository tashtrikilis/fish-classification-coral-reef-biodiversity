#!/bin/bash -l
#PBS -N extract_analysis
#PBS -l select=1:ncpus=2:mem=32GB
#PBS -l walltime=02:00:00
#PBS -j oe
# CPU only: packs the saved CV test predictions, ground truth, training logs and model sizes into
# analysis_bundle.tgz for supplementary_analysis/. Submit from this folder: qsub job_extract_analysis.pbs
cd $PBS_O_WORKDIR
source ./config.sh
module load Miniconda3
source "$VENV/bin/activate"
python extract_for_analysis.py
tar czf analysis_bundle.tgz analysis_bundle
ls -lh analysis_bundle.tgz
