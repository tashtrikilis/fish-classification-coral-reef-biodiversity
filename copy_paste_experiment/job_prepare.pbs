#!/bin/bash -l
#PBS -N cp_prepare
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -l walltime=02:00:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Builds data/ : the train/val/test split, det + seg datasets, and the
# copy-paste synthetic training images. CPU only, takes a few minutes.
cd $PBS_O_WORKDIR
source ./config.sh
module load Miniconda3
source "$VENV/bin/activate"

python prepare_experiment.py --images-dir "$IMAGES_DIR" --force
