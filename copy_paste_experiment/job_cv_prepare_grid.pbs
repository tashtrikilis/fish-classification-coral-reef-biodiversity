#!/bin/bash -l
#PBS -N cv_prep_grid
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -l walltime=02:00:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Rebuilds the CV data into data_cv2/ with the segmentation roots added, then checks its detection data
# matches data_cv/ (used for the Detection M runs). If it doesn't, the job fails and no training starts.
cd $PBS_O_WORKDIR
source ./config.sh
module load Miniconda3
source "$VENV/bin/activate"

python cv_prepare.py --images-dir "$IMAGES_DIR" --out data_cv2 --force
python cv_check_same_det.py data_cv data_cv2
