#!/bin/bash -l
#PBS -N yolo_seg_top10_l
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M your_qut_id@qut.edu.au
#PBS -j oe

# Large (yolo26l-seg), TOP-10-SPECIES subset -- same v2 restratified split as
# job_seg_top10_m.pbs, just the model size changes. Logs to the same
# runs_seg_top10 W&B project under a different run name so
# nano/small/medium/large/xlarge all show up side by side on the same graph.
#
# cls-pw kept at 0.5 for comparability with the medium run. Given how little
# data this is, don't be surprised if large doesn't clearly beat medium --
# worth checking per_class_metrics.csv against medium's, not just the
# aggregate W&B curves.

cd $PBS_O_WORKDIR

module load Miniconda3
source ~/yolo-venv/bin/activate

# export WANDB_MODE=offline  # see job_seg_top10_n.pbs for when to use this

python train_yolo.py \
    --task segment \
    --data data_seg_top10.yaml \
    --model yolo26l-seg.pt \
    --epochs 150 \
    --imgsz 1280 \
    --batch -1 \
    --workers 8 \
    --cls-pw 0.5 \
    --project runs_seg_top10 \
    --name aqua_run1_large
